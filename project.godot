; Engine configuration file.
; Opened with Godot 4.3 or newer.

config_version=5

[application]

config/name="HAZARD TREE"
config/description="Found-footage horror."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

scaling_3d/scale=1.0
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/atlas_size=8192
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=96
textures/default_filters/anisotropic_filtering_level=3

[importer_defaults]

texture={
"compress/mode": 2,
"mipmaps/generate": true,
"detect_3d/compress_to": 0
}
